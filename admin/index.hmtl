<html><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/></head><body><br>&lt;!DOCTYPE html&gt;<br>&lt;html lang="pt-BR"&gt;<br>&lt;head&gt;<br>&lt;meta charset="UTF-8"&gt;<br>&lt;meta name="viewport" content="width=device-width, initial-scale=<a href="tel:1.0">1.0</a>"&gt;<br>&lt;title&gt;VIRTUXY | Painel Administrativo&lt;/title&gt;<br>&lt;style&gt;<br>*{box-sizing:border-box}<br>body{margin:0;font-family:Arial,sans-serif;background:#f1f4f9;color:#<a href="tel:172033">172033</a>}<br>header{background:#<a href="tel:101">101</a>d35;color:white;padding:22px}<br>header h1{margin:0;color:#55d6be}<br>header p{margin:6px <a href="tel:0 0">0 0</a>;color:#cbd5e1}<br>nav{background:#<a href="tel:172943">172943</a>;padding:12px;display:flex;gap:8px;flex-wrap:wrap}<br>nav button{background:#<a href="tel:263">263</a>d5c;color:white;border:0;padding:12px;border-radius:7px;cursor:pointer}<br>nav button:hover{background:#<a href="tel:168">168</a>c83}<br>main{padding:20px;max-width:<a href="tel:1100">1100</a>px;margin:auto}<br>section{display:none}<br><a href="http://section.active">section.active</a>{display:block}<br>.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(<a href="tel:160">160</a>px,1fr));gap:14px}<br>.card,.panel{background:white;padding:20px;border-radius:12px;margin-bottom:15px;box-shadow:<a href="tel:0 2">0 2</a>px 9px #<a href="tel:0000000">0000000</a>d}<br>.card strong{font-size:27px;color:#<a href="tel:168">168</a>c83;display:block;margin-top:10px}<br>input,select,textarea{width:<a href="tel:100">100</a>%;padding:12px;margin:7px <a href="tel:0 14">0 14</a>px;border:1px solid #ccd4df;border-radius:7px}<br><a href="http://button.action">button.action</a>{background:#<a href="tel:168">168</a>c83;color:white;border:0;padding:12px 18px;border-radius:7px;cursor:pointer}<br>.item{padding:12px;border-bottom:1px solid #e5e9ef}<br>h2{color:#<a href="tel:172943">172943</a>}<br>small{color:#<a href="tel:64748">64748</a>b}<br>&lt;/style&gt;<br>&lt;/head&gt;<br>&lt;body&gt;<br>&lt;header&gt;<br>&lt;h1&gt;VIRTUXY&lt;/h1&gt;<br>&lt;p&gt;Painel de Administração e Clientes&lt;/p&gt;<br>&lt;/header&gt;<br><br>&lt;nav&gt;<br>&lt;button onclick="show('inicio')"&gt;Início&lt;/button&gt;<br>&lt;button onclick="show('clientes')"&gt;Clientes&lt;/button&gt;<br>&lt;button onclick="show('pedidos')"&gt;Pedidos&lt;/button&gt;<br>&lt;button onclick="show('projetos')"&gt;Projetos&lt;/button&gt;<br>&lt;button onclick="show('mensagens')"&gt;Atendimento&lt;/button&gt;<br>&lt;button onclick="show('financeiro')"&gt;Financeiro&lt;/button&gt;<br>&lt;/nav&gt;<br><br>&lt;main&gt;<br>&lt;section id="inicio" class="active"&gt;<br>&lt;h2&gt;Visão geral&lt;/h2&gt;<br>&lt;div class="cards"&gt;<br>&lt;div class="card"&gt;Clientes&lt;strong id="totalClientes"&gt;0&lt;/strong&gt;&lt;/div&gt;<br>&lt;div class="card"&gt;Pedidos&lt;strong id="totalPedidos"&gt;0&lt;/strong&gt;&lt;/div&gt;<br>&lt;div class="card"&gt;Projetos&lt;strong id="totalProjetos"&gt;0&lt;/strong&gt;&lt;/div&gt;<br>&lt;div class="card"&gt;Mensagens&lt;strong id="totalMensagens"&gt;0&lt;/strong&gt;&lt;/div&gt;<br>&lt;/div&gt;<br>&lt;div class="panel"&gt;<br>&lt;h3&gt;Bem-vindo à VIRTUXY!&lt;/h3&gt;<br>&lt;p&gt;Gerencie clientes, serviços, projetos, atendimento e financeiro em um só lugar.&lt;/p&gt;<br>&lt;/div&gt;<br>&lt;/section&gt;<br><br>&lt;section id="clientes"&gt;<br>&lt;h2&gt;Cadastro de clientes&lt;/h2&gt;<br>&lt;div class="panel"&gt;<br>&lt;form onsubmit="addItem(event,'clientes','clienteNome','clienteContato')"&gt;<br>&lt;label&gt;Nome do cliente&lt;/label&gt;<br>&lt;input id="clienteNome" required placeholder="Nome completo"&gt;<br>&lt;label&gt;Contato&lt;/label&gt;<br>&lt;input id="clienteContato" placeholder="E-mail ou telefone"&gt;<br>&lt;button class="action"&gt;Cadastrar cliente&lt;/button&gt;<br>&lt;/form&gt;<br>&lt;/div&gt;<br>&lt;div class="panel"&gt;&lt;h3&gt;Clientes cadastrados&lt;/h3&gt;&lt;div id="listaClientes"&gt;&lt;/div&gt;&lt;/div&gt;<br>&lt;/section&gt;<br><br>&lt;section id="pedidos"&gt;<br>&lt;h2&gt;Pedidos de serviços&lt;/h2&gt;<br>&lt;div class="panel"&gt;<br>&lt;form onsubmit="addItem(event,'pedidos','pedidoNome','pedidoDescricao')"&gt;<br>&lt;label&gt;Cliente&lt;/label&gt;<br>&lt;input id="pedidoNome" required placeholder="Nome do cliente"&gt;<br>&lt;label&gt;Serviço solicitado&lt;/label&gt;<br>&lt;textarea id="pedidoDescricao" required placeholder="Descreva o serviço"&gt;&lt;/textarea&gt;<br>&lt;button class="action"&gt;Registrar pedido&lt;/button&gt;<br>&lt;/form&gt;<br>&lt;/div&gt;<br>&lt;div class="panel"&gt;&lt;h3&gt;Pedidos registrados&lt;/h3&gt;&lt;div id="listaPedidos"&gt;&lt;/div&gt;&lt;/div&gt;<br>&lt;/section&gt;<br><br>&lt;section id="projetos"&gt;<br>&lt;h2&gt;Projetos&lt;/h2&gt;<br>&lt;div class="panel"&gt;<br>&lt;form onsubmit="addItem(event,'projetos','projetoNome','projetoDescricao')"&gt;<br>&lt;label&gt;Nome do projeto&lt;/label&gt;<br>&lt;input id="projetoNome" required placeholder="Nome do projeto"&gt;<br>&lt;label&gt;Descrição&lt;/label&gt;<br>&lt;textarea id="projetoDescricao" placeholder="Detalhes do projeto"&gt;&lt;/textarea&gt;<br>&lt;button class="action"&gt;Adicionar projeto&lt;/button&gt;<br>&lt;/form&gt;<br>&lt;/div&gt;<br>&lt;div class="panel"&gt;&lt;h3&gt;Projetos cadastrados&lt;/h3&gt;&lt;div id="listaProjetos"&gt;&lt;/div&gt;&lt;/div&gt;<br>&lt;/section&gt;<br><br>&lt;section id="mensagens"&gt;<br>&lt;h2&gt;Atendimento&lt;/h2&gt;<br>&lt;div class="panel"&gt;<br>&lt;form onsubmit="addItem(event,'mensagens','mensagemNome','mensagemTexto')"&gt;<br>&lt;label&gt;Nome do cliente&lt;/label&gt;<br>&lt;input id="mensagemNome" required placeholder="Nome"&gt;<br>&lt;label&gt;Mensagem&lt;/label&gt;<br>&lt;textarea id="mensagemTexto" required placeholder="Escreva a mensagem"&gt;&lt;/textarea&gt;<br>&lt;button class="action"&gt;Registrar mensagem&lt;/button&gt;<br>&lt;/form&gt;<br>&lt;/div&gt;<br>&lt;div class="panel"&gt;&lt;h3&gt;Mensagens registradas&lt;/h3&gt;&lt;div id="listaMensagens"&gt;&lt;/div&gt;&lt;/div&gt;<br>&lt;/section&gt;<br><br>&lt;section id="financeiro"&gt;<br>&lt;h2&gt;Financeiro&lt;/h2&gt;<br>&lt;div class="panel"&gt;<br>&lt;form onsubmit="addFinance(event)"&gt;<br>&lt;label&gt;Descrição&lt;/label&gt;<br>&lt;input id="finDescricao" required placeholder="Ex.: Serviço de desenvolvimento"&gt;<br>&lt;label&gt;Valor (R$)&lt;/label&gt;<br>&lt;input id="finValor" type="number" min="0" step="<a href="tel:0.01">0.01</a>" required placeholder="0,00"&gt;<br>&lt;label&gt;Status&lt;/label&gt;<br>&lt;select id="finStatus"&gt;<br>&lt;option&gt;Pendente&lt;/option&gt;<br>&lt;option&gt;Pago&lt;/option&gt;<br>&lt;/select&gt;<br>&lt;button class="action"&gt;Registrar lançamento&lt;/button&gt;<br>&lt;/form&gt;<br>&lt;/div&gt;<br>&lt;div class="panel"&gt;<br>&lt;h3&gt;Lançamentos&lt;/h3&gt;<br>&lt;div id="listaFinanceiro"&gt;&lt;/div&gt;<br>&lt;h3&gt;Total registrado: &lt;span id="totalFinanceiro"&gt;R$ 0,00&lt;/span&gt;&lt;/h3&gt;<br>&lt;/div&gt;<br>&lt;/section&gt;<br>&lt;/main&gt;<br><br>&lt;script&gt;<br>const secoes=['clientes','pedidos','projetos','mensagens','financeiro'];<br>let dados={};<br><a href="http://secoes.forEach">secoes.forEach</a>(k=&gt;{<br>try{dados[k]=<a href="http://JSON.parse">JSON.parse</a>(<a href="http://localStorage.getItem">localStorage.getItem</a>('virtuxy_'+k))||[]}<br>catch(e){dados[k]=[]}<br>});<br><br>function salvar(k){<br><a href="http://localStorage.setItem">localStorage.setItem</a>('virtuxy_'+k,<a href="http://JSON.stringify">JSON.stringify</a>(dados[k]));<br>render();<br>}<br><br>function show(id){<br><a href="http://document.querySelectorAll">document.querySelectorAll</a>('main section').forEach(s=&gt;<a href="http://s.classList.remove">s.classList.remove</a>('active'));<br><a href="http://document.getElementById">document.getElementById</a>(id).<a href="http://classList.add">classList.add</a>('active');<br>}<br><br>function addItem(event,k,id1,id2){<br><a href="http://event.preventDefault">event.preventDefault</a>();<br>dados[k].push({<br>nome:<a href="http://document.getElementById">document.getElementById</a>(id1).value,<br>descricao:<a href="http://document.getElementById">document.getElementById</a>(id2).value,<br>data:new Date().toLocaleDateString('pt-BR')<br>});<br>salvar(k);<br><a href="http://event.target.reset">event.target.reset</a>();<br>alert('Registro salvo com sucesso!');<br>}<br><br>function addFinance(event){<br><a href="http://event.preventDefault">event.preventDefault</a>();<br><a href="http://dados.financeiro.push">dados.financeiro.push</a>({<br>nome:<a href="http://document.getElementById">document.getElementById</a>('finDescricao').value,<br>valor:Number(<a href="http://document.getElementById">document.getElementById</a>('finValor').value),<br>status:<a href="http://document.getElementById">document.getElementById</a>('finStatus').value<br>});<br>salvar('financeiro');<br><a href="http://event.target.reset">event.target.reset</a>();<br>alert('Lançamento registrado!');<br>}<br><br>function listar(k){<br>const el=<a href="http://document.getElementById">document.getElementById</a>('lista'+k[0].toUpperCase()+<a href="http://k.slice">k.slice</a>(1));<br><a href="http://el.innerHTML">el.innerHTML</a>='';<br>dados[k].forEach((item,i)=&gt;{<br>const div=<a href="http://document.createElement">document.createElement</a>('div');<br><a href="http://div.className">div.className</a>='item';<br><a href="http://div.textContent">div.textContent</a>=(<a href="http://item.nome">item.nome</a>||'')+' — '+(<a href="http://item.descricao">item.descricao</a>||'')+' — '+(<a href="http://item.data">item.data</a>||'');<br>const excluir=<a href="http://document.createElement">document.createElement</a>('button');<br><a href="http://excluir.textContent">excluir.textContent</a>='Excluir';<br><a href="http://excluir.className">excluir.className</a>='action';<br><a href="http://excluir.style.marginLeft">excluir.style.marginLeft</a>='10px';<br><a href="http://excluir.onclick">excluir.onclick</a>=()=&gt;{if(confirm('Excluir este registro?')){dados[k].splice(i,1);salvar(k)}};<br><a href="http://div.appendChild">div.appendChild</a>(excluir);<br><a href="http://el.appendChild">el.appendChild</a>(div);<br>});<br>}<br><br>function render(){<br><a href="http://secoes.forEach">secoes.forEach</a>(k=&gt;{if(k!=='financeiro')listar(k)});<br><a href="http://document.getElementById">document.getElementById</a>('totalClientes').textContent=<a href="http://dados.clientes.length">dados.clientes.length</a>;<br><a href="http://document.getElementById">document.getElementById</a>('totalPedidos').textContent=<a href="http://dados.pedidos.length">dados.pedidos.length</a>;<br><a href="http://document.getElementById">document.getElementById</a>('totalProjetos').textContent=<a href="http://dados.projetos.length">dados.projetos.length</a>;<br><a href="http://document.getElementById">document.getElementById</a>('totalMensagens').textContent=<a href="http://dados.mensagens.length">dados.mensagens.length</a>;<br>const lista=<a href="http://document.getElementById">document.getElementById</a>('listaFinanceiro');<br><a href="http://lista.innerHTML">lista.innerHTML</a>='';<br>let total=0;<br><a href="http://dados.financeiro.forEach">dados.financeiro.forEach</a>((item,i)=&gt;{<br>total+=<a href="http://item.valor">item.valor</a>;<br>const div=<a href="http://document.createElement">document.createElement</a>('div');<br><a href="http://div.className">div.className</a>='item';<br><a href="http://div.textContent">div.textContent</a>=<a href="http://item.nome">item.nome</a>+' — R$ '+<a href="http://item.valor.toFixed">item.valor.toFixed</a>(2)+' — '+<a href="http://item.status">item.status</a>;<br>const excluir=<a href="http://document.createElement">document.createElement</a>('button');<br><a href="http://excluir.textContent">excluir.textContent</a>='Excluir';<br><a href="http://excluir.className">excluir.className</a>='action';<br><a href="http://excluir.style.marginLeft">excluir.style.marginLeft</a>='10px';<br><a href="http://excluir.onclick">excluir.onclick</a>=()=&gt;{if(confirm('Excluir este lançamento?')){<a href="http://dados.financeiro.splice">dados.financeiro.splice</a>(i,1);salvar('financeiro')}};<br><a href="http://div.appendChild">div.appendChild</a>(excluir);<br><a href="http://lista.appendChild">lista.appendChild</a>(div);<br>});<br><a href="http://document.getElementById">document.getElementById</a>('totalFinanceiro').textContent=<a href="http://total.toLocaleString">total.toLocaleString</a>('pt-BR',{style:'currency',currency:'BRL'});<br>}<br>render();<br>&lt;/script&gt;<br>&lt;/body&gt;<br>&lt;/html&gt;<br></body></html>
